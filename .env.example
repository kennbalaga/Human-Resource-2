APP_NAME="Memorial Hospital & Sanitarium"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Placeholder branding. The client hospital's name and seal are not cleared for
# use yet, so the app ships neutral; set these (and swap the artwork in
# public/images/icons + public/favicon.svg) once permission comes through.
BRAND_ORGANIZATION="Memorial Hospital & Sanitarium"
BRAND_SHORT_NAME="WorkForce"
BRAND_TAGLINE="Hospital Workforce & HR System"

# Production-only hardening. Defaults to on automatically once APP_ENV=production
# (see config/security.php) — this line only matters if you want to override
# that default. Local/testing are unaffected regardless of this value.
SECURITY_ENFORCE_PRODUCTION=false

# Browser attack containment. Enforcing is the default and the production
# requirement; the two inline scripts in the app carry a per-request nonce, so
# there is nothing left to observe. Drop to report-only only while diagnosing a
# violation, and put it back.
CSP_MODE=enforce
CSP_REPORT_URI=/api/v1/security/csp-report

# File downloads (reports, exports, leave attachments) ask for the account
# password again once this many seconds have passed since it was last entered,
# and one account may take at most DOWNLOAD_RATE_LIMIT files per minute.
DOWNLOAD_PASSWORD_TIMEOUT=900
DOWNLOAD_RATE_LIMIT=20

# Proxies allowed to set X-Forwarded-* on the way in. The loopback default
# covers a local tunnel (ngrok, cloudflared). Behind a load balancer, list its
# address(es) comma-separated; use "*" only where the platform guarantees every
# request passed through its edge. Getting this wrong either breaks HTTPS URL
# generation or lets a client choose the IP the rate limiter and audit log see.
TRUSTED_PROXIES=127.0.0.1

# Require authenticator-app 2FA for privileged workforce roles.
TWO_FACTOR_REQUIRED_ROLES=system-administrator,hr-manager,department-head

# Roles that may not use this app on a phone or tablet at all, and that are never
# offered the installable app. These accounts read the whole organisation's
# records, and the device-local PIN that protects a handset is not the right
# safeguard for that much reach. Staff who only see their own records are
# unaffected. Set it empty to lift the restriction — which is how an
# administrator account is tested on a real handset.
MOBILE_RESTRICTED_ROLES=system-administrator,hr-manager,department-head

# How long a phone stays trusted to sign in without an authenticator code after
# its app lock was set up. Removing the lock withdraws the trust immediately, so
# this is only the backstop for a handset that quietly stops being used.
MOBILE_TRUST_DAYS=180

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Error tracking (optional). Sign up at sentry.io (or point at a self-hosted
# instance), create a project, and paste its DSN here. Empty/unset means the
# SDK is a safe no-op — nothing is sent, nothing else changes.
SENTRY_LARAVEL_DSN=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=human_resource_2
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_WARNING_SECONDS=300
SESSION_HEARTBEAT_SECONDS=5
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# Optional locally; required by the production security check, and defaulted on
# automatically once APP_ENV=production (see config/security.php), so this line
# only matters as a local override. Windows may use an absolute path ending in
# clamscan.exe. Production should fail closed.
MALWARE_SCANNING_ENABLED=false
MALWARE_SCANNING_DRIVER=clamav
CLAMAV_BINARY=clamscan
CLAMAV_TIMEOUT_SECONDS=30
MALWARE_SCANNING_FAIL_CLOSED=true

# Data retention (docs/DATA_PRIVACY.md). Left unset by default so
# `records:prune-expired` prunes nothing until your organization has
# confirmed actual retention periods — see the proposed defaults in that doc.
# PRIVACY_RETAIN_ATTENDANCE_DAYS=1095
# PRIVACY_RETAIN_LEAVE_DAYS=1095
# PRIVACY_RETAIN_AUDIT_LOGS_DAYS=1825

# The Data Protection Officer printed on the public /privacy-policy page. Unset
# means the page names the HR office instead of an address — never a made-up
# mailbox. RA 10173 requires a reachable DPO, so set these before go-live.
# PRIVACY_DPO_NAME="Juan Dela Cruz, RN"
# PRIVACY_DPO_EMAIL=dpo@example.gov.ph
# PRIVACY_DPO_PHONE="(02) 8000 0000 loc. 000"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

INITIAL_USER_PASSWORD="ChangeMe123!"

ATTENDANCE_OFFICE_NAME="Main Hospital"
ATTENDANCE_OFFICE_ADDRESS="Memorial Hospital & Sanitarium"
ATTENDANCE_WORK_START=08:00
ATTENDANCE_WORK_END=17:00
ATTENDANCE_GRACE_MINUTES=15
ATTENDANCE_BREAK_MINUTES=60

# Biometric bridge agent (docs/BIOMETRIC_HANDOFF.md). The ZKTeco terminal sits
# behind hospital NAT and cannot push, so a Python agent on the hospital LAN
# polls it and POSTs batches to /api/biometric/punches, signing each body with
# this secret. Generate with `openssl rand -hex 32` and set the same value as
# the agent's BRIDGE_SECRET. Unset means the endpoint refuses every request --
# it never falls back to an unsigned mode.
# BIOMETRIC_BRIDGE_SECRET=
# Punches older than this are stored but not turned into attendance; the agent
# queues through outages, so this allows for a real backlog while still
# catching a terminal clock that has come loose.
# BIOMETRIC_BRIDGE_MAX_PUNCH_AGE_HOURS=72
# BIOMETRIC_BRIDGE_MAX_BATCH_SIZE=500
# BIOMETRIC_BRIDGE_REQUESTS_PER_MINUTE=120
# BIOMETRIC_BRIDGE_DEVICE_REQUESTS_PER_MINUTE=60

SCHEDULE_MAX_RECURRENCE_DAYS=180

WORKFORCE_STANDARD_DAILY_MINUTES=480
WORKFORCE_ANALYTICS_MAX_DAYS=366
WORKFORCE_LEAVE_MAX_DAYS=30
WORKFORCE_ATTACHMENT_MAX_KB=5120
# Where leave supporting documents are written. Deliberately separate from
# FILESYSTEM_DISK so a public default disk can never expose medical records.
# `database` keeps the file in the database beside its row, so every computer
# sharing the database can open it. Existing rows keep the disk they were
# uploaded to; `php artisan leave-attachments:move-to-database` brings them over.
WORKFORCE_ATTACHMENT_DISK=database
WORKFORCE_EMPLOYEE_ID_AUTO_GENERATE=true
# Days in Terminated before a record is archived automatically. 0 disables it.
WORKFORCE_TERMINATED_ARCHIVE_AFTER_DAYS=30
WORKFORCE_ATTENDANCE_CAPTURE_MODE=hybrid
LOCAL_EMPLOYEE_DEFAULT_PASSWORD=ChangeMe123!

# Burnout risk indicator. Non-medical; see docs/BURNOUT_RISK.md. The factor
# floors and ceilings live in config/burnout.php.
BURNOUT_WINDOW_DAYS=28
BURNOUT_MODERATE_SCORE=35
BURNOUT_HIGH_SCORE=60
BURNOUT_RETENTION_DAYS=365
# Stricter scheduling limits for employees at high risk. false turns them off
# and leaves the indicator itself in place.
BURNOUT_PROTECTION_ENABLED=true
BURNOUT_PROTECTED_DAYS_OFF=2
BURNOUT_PROTECTED_MAX_WEEKLY_HOURS=40
BURNOUT_PROTECTED_MAX_NIGHTS=2

INTEGRATION_TIMEOUT_SECONDS=10
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_WORKFORCE_SCHEDULING_ENABLED=false
AI_SCHEDULING_GEMINI_EXPLANATIONS=false
AI_SCHEDULING_RECOMMENDATION_TTL_MINUTES=15
AI_SCHEDULING_HISTORY_DAYS=28
AI_SCHEDULING_MODERATE_RISK_SCORE=35
AI_SCHEDULING_HIGH_RISK_SCORE=65
# Advisory display references only; hospital HR review is required before enabling.
AI_SCHEDULING_REFERENCE_WEEKLY_MINUTES=2400
AI_SCHEDULING_REFERENCE_OVERTIME_MINUTES=480
AI_SCHEDULING_REFERENCE_RECENT_ASSIGNMENTS=20
AI_SCHEDULING_REFERENCE_CONSECUTIVE_DUTIES=5
AI_SCHEDULING_REFERENCE_REST_HOURS=8

SANCTUM_EXPIRATION=1440
SANCTUM_TOKEN_PREFIX=hrms_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Gmail SMTP (optional). Turn on Google 2-Step Verification and use a
# 16-character App Password; never place your normal Gmail password here.
GMAIL_SMTP_USERNAME=
GMAIL_SMTP_APP_PASSWORD=

AUTH_PASSWORD_RESET_EXPIRE=30
AUTH_PASSWORD_RESET_THROTTLE=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
