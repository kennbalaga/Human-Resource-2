APP_NAME="Dr. Jose N. Rodriguez HRMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Require authenticator-app 2FA for privileged workforce roles.
TWO_FACTOR_REQUIRED_ROLES=system-administrator,hr-manager,department-head

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=human_resource_2
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

INITIAL_USER_PASSWORD="ChangeMe123!"

ATTENDANCE_OFFICE_NAME="Main Hospital"
ATTENDANCE_OFFICE_ADDRESS="Dr. Jose N. Rodriguez Memorial Hospital and Sanitarium"
ATTENDANCE_WORK_START=08:00
ATTENDANCE_WORK_END=17:00
ATTENDANCE_GRACE_MINUTES=15
ATTENDANCE_BREAK_MINUTES=60

SCHEDULE_TIMEZONE=Asia/Manila
SCHEDULE_MAX_RECURRENCE_DAYS=180

WORKFORCE_TIMEZONE=Asia/Manila
WORKFORCE_STANDARD_DAILY_MINUTES=480
WORKFORCE_ANALYTICS_MAX_DAYS=366
WORKFORCE_LEAVE_MAX_DAYS=30
WORKFORCE_ATTACHMENT_MAX_KB=5120

INTEGRATION_TIMEOUT_SECONDS=10
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_WORKFORCE_SCHEDULING_ENABLED=false
AI_SCHEDULING_GEMINI_EXPLANATIONS=false
AI_SCHEDULING_RECOMMENDATION_TTL_MINUTES=15
AI_SCHEDULING_HISTORY_DAYS=28
AI_SCHEDULING_MODERATE_RISK_SCORE=35
AI_SCHEDULING_HIGH_RISK_SCORE=65
# Advisory display references only; hospital HR review is required before enabling.
AI_SCHEDULING_REFERENCE_WEEKLY_MINUTES=2400
AI_SCHEDULING_REFERENCE_OVERTIME_MINUTES=480
AI_SCHEDULING_REFERENCE_RECENT_ASSIGNMENTS=20
AI_SCHEDULING_REFERENCE_CONSECUTIVE_DUTIES=5
AI_SCHEDULING_REFERENCE_REST_HOURS=8

SANCTUM_EXPIRATION=1440
SANCTUM_TOKEN_PREFIX=hrms_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Gmail SMTP (optional). Turn on Google 2-Step Verification and use a
# 16-character App Password; never place your normal Gmail password here.
GMAIL_SMTP_USERNAME=
GMAIL_SMTP_APP_PASSWORD=

AUTH_PASSWORD_RESET_EXPIRE=30
AUTH_PASSWORD_RESET_THROTTLE=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
