# Bridge agent configuration.
#
# Copy this file to bridge.env in the same folder and fill it in. bridge.env is
# gitignored because it holds the shared secret.
#
#     cp bridge.env.example bridge.env

# --- The terminal -----------------------------------------------------------

# From the device's Comm. menu. 192.168.1.201 was the test-network address and
# will be different at the hospital -- check it on the terminal itself.
BRIDGE_DEVICE_IP=192.168.1.201
BRIDGE_DEVICE_PORT=4370

# Comm. > PC Connection. Still the factory default 0 on this unit, which should
# be changed before go-live; change it here at the same time.
BRIDGE_DEVICE_COMM_KEY=0

# The serial the agent signs as. Checked against what the device reports on
# every poll, and the agent refuses to send if they differ -- posting one
# terminal's punches under another's serial would file a ward's attendance
# against the wrong device.
BRIDGE_DEVICE_SERIAL=QME2261300147

# How long to wait on the device before giving up (seconds).
BRIDGE_DEVICE_TIMEOUT_SECONDS=10

# --- The server -------------------------------------------------------------

BRIDGE_SERVER_URL=https://workforce.djnrmhs.com/api/biometric/punches

# Must equal BIOMETRIC_BRIDGE_SECRET in the application's .env, exactly. One
# character out and every batch comes back 401. Generate with:
#     openssl rand -hex 32
BRIDGE_SECRET=

BRIDGE_TIMEOUT_SECONDS=30

# Leave true. false disables certificate checking and is only defensible on a
# trusted LAN with a self-signed certificate -- it sends the shared secret's
# signature over a connection nobody has verified.
BRIDGE_VERIFY_TLS=true

# --- Behaviour --------------------------------------------------------------

# Seconds between polls. 5 puts a scan in the system almost as fast as the
# person can look up at a screen.
#
# What actually bounds this, in order:
#
#   The device, not the server. Most polls send nothing at all -- the agent
#   only posts when it has something undelivered -- so the server's limit of 60
#   requests a minute per terminal is rarely approached. Every poll does read
#   the WHOLE device log though, because the agent never clears it.
#
#   Cycles never overlap: the agent sleeps after finishing, so a slow read
#   stretches the gap rather than piling up behind itself. A log that has grown
#   into the tens of thousands quietly turns a 5-second poll into something
#   much longer.
#
#   Only one program may hold the terminal. The more often this polls, the more
#   often somebody enrolling a finger through ZKTime finds it busy. Raise it
#   while a ward is being enrolled.
#
# Watch the "Device holds N punch record(s)" line. When N climbs into the
# thousands, either raise this or clear the device log once everything has been
# confirmed delivered (see README).
BRIDGE_POLL_SECONDS=5

# Punches per request. The server refuses anything above its own ceiling (500
# by default), and the agent caps itself there regardless of what is set here.
BRIDGE_BATCH_SIZE=200

# The local queue. Punches live here from the moment they are read until the
# server confirms them, so this file is what makes a restart safe. Back it up
# with the machine; losing it only costs a re-read of the device log, which is
# never cleared.
BRIDGE_STATE_DB=bridge_state.sqlite3

BRIDGE_LOG_FILE=bridge_agent.log

# Warn when the terminal clock differs from this PC by more than this many
# seconds. A drifting clock silently corrupts every timestamp it stamps, and
# those timestamps are the attendance record.
BRIDGE_CLOCK_DRIFT_SECONDS=120
