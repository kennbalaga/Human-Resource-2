{
  "info": {
    "_postman_id": "e57e78e6-9c8f-4cf5-88d8-c01dcb2e9001",
    "name": "HRMS Workforce API",
    "description": "Versioned Workforce Management REST API. Select the HRMS Local environment and run Create token first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });",
          "pm.request.headers.upsert({ key: 'X-Request-ID', value: pm.variables.replaceIn('{{$guid}}') });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Create token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token created', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.token) pm.environment.set('token', body.data.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"employee_id\": \"{{employee_id}}\",\n  \"password\": \"{{password}}\",\n  \"device_name\": \"Postman\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            }
          }
        },
        {
          "name": "Revoke current token",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/auth/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Employees",
      "item": [
        {
          "name": "List employees",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/employees?per_page=25",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "employees"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "25"
                }
              ]
            }
          }
        },
        {
          "name": "Show employee",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/employees/{{employee_record_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "employees",
                "{{employee_record_id}}"
              ]
            }
          }
        }
      ]
    },
