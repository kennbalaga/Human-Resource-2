{
    "id": "./dashboard",
    "name": "Memorial Hospital & Sanitarium",
    "short_name": "HRMS",
    "description": "Attendance, scheduling, leave, and workforce management for hospital personnel.",
    "start_url": "./dashboard",
    "scope": "./",
    "display": "standalone",
    "display_override": [
        "standalone",
        "minimal-ui",
        "browser"
    ],
    "orientation": "portrait-primary",
    "theme_color": "#176b43",
    "background_color": "#f4f7f6",
    "lang": "en",
    "dir": "ltr",
    "categories": [
        "business",
        "productivity",
        "medical"
    ],
    "prefer_related_applications": false,
    "icons": [
        {
            "src": "./images/icons/icon-192.png",
            "type": "image/png",
            "sizes": "192x192",
            "purpose": "any"
        },
        {
            "src": "./images/icons/icon-512.png",
            "type": "image/png",
            "sizes": "512x512",
            "purpose": "any"
        },
        {
            "src": "./images/icons/icon-maskable-192.png",
            "type": "image/png",
            "sizes": "192x192",
            "purpose": "maskable"
        },
        {
            "src": "./images/icons/icon-maskable-512.png",
            "type": "image/png",
            "sizes": "512x512",
            "purpose": "maskable"
        }
    ],
    "shortcuts": [
        {
            "name": "Attendance",
            "short_name": "Attendance",
            "description": "Check in, check out, and scan attendance badges.",
            "url": "./attendance",
            "icons": [
                {
                    "src": "./images/icons/icon-192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Schedules",
            "short_name": "Schedules",
            "description": "View the shift roster and your upcoming schedule.",
            "url": "./schedules",
            "icons": [
                {
                    "src": "./images/icons/icon-192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        },
        {
            "name": "Leave Management",
            "short_name": "Leave",
            "description": "File a leave request and track approvals.",
            "url": "./leaves",
            "icons": [
                {
                    "src": "./images/icons/icon-192.png",
                    "sizes": "192x192",
                    "type": "image/png"
                }
            ]
        }
    ]
}
